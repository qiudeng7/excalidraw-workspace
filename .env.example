# Optional deployment variables for embedding in a host app. All default to off/empty.
#
# Public URL prefix when served behind a reverse proxy, e.g. /apps/excalidraw.
# The proxy strips this prefix before forwarding, so server routes stay unprefixed.
# Drives the browser-side editor asset path and the federation publicPath only.
# WORKSPACE_BASE=
#
# Build-time switch: publish a Module Federation remote (mf-manifest.json + remoteEntry.js).
# Exposes ./WorkspaceApp ./WorkspaceSidebar ./CanvasStage ./CanvasTabs ./SettingsPanel
# ./AccountGate ./client. Federation name must be unique per deployment.
# MF_ENABLED=true
# MF_NAME=excalidraw-workspace
#
# Local account switch (runtime, Node env or Worker vars). Defaults to on.
# OIDC identity providers are configured in the app under Settings -> System ->
# Login methods and stored in the database; they are not environment variables.
# AUTH_LOCAL=true
