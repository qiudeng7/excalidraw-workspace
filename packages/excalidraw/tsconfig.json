{
  "compilerOptions": {
    "outDir": "./dist/types",
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "emitDeclarationOnly": true,
    "paths": {
      "@excalidraw/excalidraw": [
        "./index.tsx"
      ],
      "@excalidraw/utils": [
        "./lib/utils/src/index.ts"
      ],
      "@excalidraw/math": [
        "./lib/math/src/index.ts"
      ],
      "@excalidraw/excalidraw/*": [
        "./*"
      ],
      "@excalidraw/utils/*": [
        "./lib/utils/src/*"
      ],
      "@excalidraw/math/*": [
        "./lib/math/src/*"
      ],
      "@excalidraw/common": [
        "./lib/common/src/index.ts"
      ],
      "@excalidraw/common/*": [
        "./lib/common/src/*"
      ],
      "@excalidraw/element": [
        "./lib/element/src/index.ts"
      ],
      "@excalidraw/element/*": [
        "./lib/element/src/*"
      ],
      "@excalidraw/excalidraw/common/*": [
        "./lib/common/src/*"
      ],
      "@excalidraw/excalidraw/element/*": [
        "./lib/element/src/*"
      ],
      "@excalidraw/excalidraw/math/*": [
        "./lib/math/src/*"
      ],
      "@excalidraw/excalidraw/utils/*": [
        "./lib/utils/src/*"
      ],
      "@excalidraw/fractional-indexing": [
        "./lib/fractional-indexing/src/index.ts"
      ]
    },
    "rootDir": "."
  },
  "exclude": [
    "**/*.test.*",
    "**/tests/**",
    "types",
    "examples",
    "**/dist/**",
    "**/node_modules/**",
    "**/test-utils.ts",
    "**/__tests__/**",
    "**/vitest.config.*"
  ]
}
