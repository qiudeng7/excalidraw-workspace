{
  "name": "excalidraw-workspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:editor && nuxt dev --host 0.0.0.0",
    "build": "pnpm build:editor && NITRO_PRESET=cloudflare-module nuxt build",
    "preview": "nuxt preview",
    "build:editor": "pnpm --filter @excalidraw/excalidraw build",
    "dev:worker": "wrangler dev --port 8787 --var PUBLIC_ORIGIN:http://localhost:8787",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:backend": "tsx --test tests/backend/*.test.ts",
    "deploy": "pnpm build && wrangler deploy",
    "build:node": "pnpm build:editor && NITRO_PRESET=node-server nuxt build",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "format:backend": "eslint \"server/**/*.ts\" --quiet --fix && prettier --write \"server/**/*.ts\"",
    "format:check": "eslint \"**/*.{vue,ts,tsx}\" --quiet && prettier --check \"**/*.{vue,ts,tsx}\"",
    "format": "eslint \"**/*.{vue,ts,tsx}\" --quiet --fix && prettier --write \"**/*.{vue,ts,tsx}\"",
    "lint": "eslint \"**/*.{vue,ts,tsx}\" --quiet",
    "test:lint": "tsx --test tests/lint/*.test.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "workspace:*",
    "@pinia/nuxt": "1.0.2",
    "awilix": "13.0.5",
    "nuxt": "4.6.0",
    "pinia": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "^8.3.4",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.141.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  }
}
