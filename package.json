{
  "name": "excalidraw-workspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:editor && pnpm db:migrate && nuxt dev --host 0.0.0.0",
    "build": "pnpm build:editor && NITRO_PRESET=cloudflare-module nuxt build",
    "preview": "nuxt preview",
    "build:editor": "pnpm --filter @excalidraw/excalidraw build",
    "dev:worker": "wrangler dev --port 8787 --var PUBLIC_ORIGIN:http://localhost:8787",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:backend": "pnpm test:unit && pnpm test:integration",
    "deploy": "pnpm build && pnpm db:migrate:remote && wrangler deploy",
    "build:node": "pnpm build:editor && NITRO_PRESET=node-server nuxt build",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:lint": "tsx --test tests/lint/*.test.ts",
    "db:generate": "nuxt db generate",
    "db:migrate": "node scripts/check-data-layout.mjs && nuxt db migrate",
    "start:node": "pnpm db:migrate && node .output/server/index.mjs",
    "data:import": "node scripts/import-legacy-data.mjs",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "test:worker": "node tests/http/run-worker.mjs",
    "prepare": "node scripts/git-hooks/install.mjs",
    "hooks:install": "node scripts/git-hooks/install.mjs",
    "hooks:uninstall": "node scripts/git-hooks/install.mjs --uninstall",
    "lint:fix": "eslint . --fix",
    "check:staged": "node scripts/check-staged.mjs",
    "check:pre-push": "pnpm test:backend && pnpm typecheck:prepare && pnpm typecheck",
    "typecheck:prepare": "pnpm --filter @excalidraw/excalidraw exec tsc --project tsconfig.json && node packages/excalidraw/sync-types.mjs && nuxt prepare",
    "test:hooks": "node --test tests/hooks/*.test.mjs",
    "test:unit": "node --import ./tests/lib/loader.mjs --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import ./tests/lib/loader.mjs --import tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "workspace:*",
    "@libsql/client": "0.18.0",
    "@nuxthub/core": "0.10.8",
    "@pinia/nuxt": "1.0.2",
    "drizzle-orm": "0.45.4",
    "h3": "1.15.11",
    "nuxt": "4.6.1",
    "pinia": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@playwright/test": "1.64.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "^8.3.4",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.141.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  }
}
