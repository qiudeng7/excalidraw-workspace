{
  "name": "excalidraw-demo",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": ".output/server/index.mjs",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "excalidraw-demo",
      "database_id": "ff5e553f-7dac-48c5-b340-76d9c0fc19ef",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "excalidraw-demo-data"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://excalidraw-demo.qiudeng.workers.dev"
  }
}
