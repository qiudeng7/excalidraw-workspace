{
  "name": "excalidraw-workspace",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 * * * *"] },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    // Nitro matches static asset paths exactly, including .html extensions.
    "html_handling": "none",
  },
  "main": "server/worker.mjs",
  // The Worker wrapper and Durable Object are bundled outside Nuxt by Wrangler.
  "tsconfig": ".nuxt/tsconfig.server.json",
  "durable_objects": {
    "bindings": [{ "name": "CANVAS_ROOMS", "class_name": "CanvasRoom" }],
  },
  "migrations": [
    { "tag": "canvas-room-v1", "new_sqlite_classes": ["CanvasRoom"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "excalidraw-demo",
      "database_id": "ff5e553f-7dac-48c5-b340-76d9c0fc19ef",
      "migrations_dir": "server/db/migrations/sqlite",
      "migrations_table": "d1_migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "excalidraw-demo-data",
    },
  ],
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_ORIGIN": "https://excalidraw-workspace.qiudeng.workers.dev",
  },
}
